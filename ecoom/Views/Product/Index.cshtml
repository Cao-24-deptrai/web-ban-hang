@model IEnumerable<ecoom.Models.Product>

@{
    ViewBag.Title = "Danh Sách Sản Phẩm";
}

<h2 class="mb-4">
    <i class="fas fa-shoe-prints"></i> Sản Phẩm
</h2>

<!-- Filter Section -->
<div class="filter-section">
    <h5><i class="fas fa-filter"></i> Lọc Theo Giá</h5>
    @using (Html.BeginForm("IndexCustomer", "Product", FormMethod.Get))
    {
        <div class="filter-group">
            <div class="form-group">
                <label for="minPrice">Giá Tối Thiểu (đ):</label>
                <input type="number" id="minPrice" name="_min" placeholder="0" class="form-control"
                    value="@ViewBag.MinPrice" />
            </div>
            <div class="form-group">
                <label for="maxPrice">Giá Tối Đa (đ):</label>
                <input type="number" id="maxPrice" name="_max" placeholder="1000000" class="form-control"
                    value="@ViewBag.MaxPrice" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> Tìm Kiếm
            </button>
            <a href="@Url.Action("IndexCustomer", "Product")" class="btn btn-outline-secondary">
                <i class="fas fa-redo"></i> Đặt Lại
            </a>
        </div>
    }
</div>

<!-- Products Grid -->
@if (Model != null && Model.Count() > 0)
{
    <div class="products-grid">
        @foreach (var item in Model)
        {
            <div class="product-card">
                <div class="product-image-container">
                    @if (!string.IsNullOrEmpty(item.ImagePro))
                    {
                        <img src="@item.ImagePro" alt="@item.NamePro" class="product-image">
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/250?text=No+Image" alt="No Image" class="product-image">
                    }
                </div>
                <div class="product-info">
                    <h5 class="product-name">@item.NamePro</h5>
                    <p class="product-description">@item.DecriptionPro</p>
                    <div class="product-price">@item.Price.ToString("N0") đ</div>
                    <div class="product-actions">
                        <button class="btn btn-sm btn-primary" onclick="addToCart(@item.ProductID)">
                            <i class="fas fa-shopping-cart"></i> Thêm
                        </button>
                        <a href="#" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-eye"></i> Xem
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center" role="alert">
        <i class="fas fa-inbox"></i>
        <p class="mt-2">Không có sản phẩm nào phù hợp với tiêu chí tìm kiếm của bạn.</p>
    </div>
}

@section scripts {
    <script type="text/javascript">
        function addToCart(productId) {
            alert('Thêm sản phẩm vào giỏ hàng: ' + productId);
            // TODO: Implement add to cart functionality
        }
    </script>
}