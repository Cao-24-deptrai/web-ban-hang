}

<h2>Danh sách ??n hàng</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã ??n</th>
            <th>Ngày</th>
            <th>Khách hàng</th>
            <th>??a ch? giao</th>
            <th>Hành ??ng</th>
        </tr>
